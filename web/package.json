{
  "name": "prosa-web",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "desktop:dev": "PROSA_DEV_URL=http://localhost:5173 electron .",
    "dist": "vite build && electron-builder --mac dmg",
    "dist:universal": "vite build && electron-builder --mac dmg --universal",
    "dist:arm64": "vite build && electron-builder --mac dmg --arm64",
    "dist:x64": "vite build && electron-builder --mac dmg --x64",
    "dist:win": "vite build && electron-builder --win nsis",
    "dist:win:x64": "vite build && electron-builder --win nsis --x64",
    "dist:win:arm64": "vite build && electron-builder --win nsis --arm64"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  }
}
