# Identidade (troque quando a nova marca for aprovada)
APP_NAME=Prosa

# Rede
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Dados
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
WEB_DIST=./web/dist

# Postgres local via docker-compose.yml (docker compose up -d db)
# O compose le estas variaveis do .env (com defaults abaixo):
POSTGRES_USER=prosa
POSTGRES_PASSWORD=prosa
POSTGRES_DB=prosa
POSTGRES_PORT=5432
# Conexao usada pelo backend (npm run dev roda fora do Docker):
DATABASE_URL=postgres://prosa:prosa@localhost:5432/prosa

# Segurança
SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=25

# WebRTC — para produção atrás de NAT restritivo, configure um TURN:
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:seu-turn:3478","username":"u","credential":"p"}]
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# ICE do modo P2P (experimental, frontend).
# Precedência: localStorage "prosa_ice" > VITE_ICE_SERVERS_JSON (build) > default Google.
# Formato: array JSON de RTCIceServer. TURN é opcional e só necessário onde
# conexão direta é inviável (NAT simétrico/CGNAT/UDP bloqueado).
# Ex. com TURN próprio:
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:seu-stun:3478"},{"urls":"turn:seu-turn:3478","username":"u","credential":"p"}]
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
#
# Em runtime (app empacotado), configure pelo console/devtools:
#   localStorage.setItem('prosa_ice', '[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:seu-turn:3478","username":"u","credential":"p"}]')
# Para voltar ao default: localStorage.removeItem('prosa_ice')

# SMTP (opcional — sem ele, tokens de reset aparecem no log/console em dev)
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM=no-reply@exemplo.com

# CORS para clientes cross-origin (app desktop Electron usa Origin "null")
# Ex.: CORS_ORIGINS="null,https://prosa.app"
# CORS_ORIGINS=